[sub_resource type="Shader" id="Shader_cl5sw"]
code = "shader_type canvas_item;
render_mode unshaded, blend_add;

uniform sampler2D depth_tex : filter_linear;
uniform sampler2D screen_texture : hint_screen_texture, filter_linear;
uniform sampler2D light_color : hint_default_white;
uniform vec4 ray_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float ray_length : hint_range(0.0, 1.0) = 1.0;
uniform float ray_intensity : hint_range(0.0, 1.0) = 1.0;
uniform float light_source_scale = 1.0;
uniform float light_source_feather = 2.0;
uniform float noise_strength : hint_range(0.0, 1.0) = 0.2;
uniform vec2 light_source_pos = vec2(0.0, 0.0);
uniform vec3 light_source_dir = vec3(0.5, -1.0, 0.25);
uniform float mask_threshold : hint_range(0.0, 1.0) = 0.5;
uniform float mask_softness : hint_range(0.01, 0.5) = 0.15;
uniform float mask_radius : hint_range(0.01, 0.5) = 0.15;
uniform bool debug_mode = false;
uniform float debug_dot_radius : hint_range(0.001, 0.05) = 0.01;

const int SAMPLE_COUNT = 120;

float random(vec2 uv) {
	return fract(sin(dot(uv.xy, vec2(12.9898, 78.233))) * 43758.5453123);
}

void fragment() {
	vec2 light_pos = light_source_pos;
	vec2 ratio = vec2(SCREEN_PIXEL_SIZE.x / SCREEN_PIXEL_SIZE.y, 1.0);

	if (debug_mode) {
		vec2 diff = (UV - light_pos) / ratio;
		float dist = length(diff);
		float dot_mask = smoothstep(debug_dot_radius, debug_dot_radius * 0.5, dist);
		COLOR.rgb = vec3(dot_mask);
		COLOR.a = 1.0;
	} else {
		vec2 dir = UV - light_pos;
		vec2 dir2 = UV / ratio - light_pos / ratio;
		float light_rays = 0.0;
		vec2 uv2;
		float scale, l;

		for (int i = 0; i < SAMPLE_COUNT; i++) {
			scale = 1.0 - ray_length * (float(i) / float(SAMPLE_COUNT - 1));
			vec2 sample_uv = dir * scale + light_pos;
			l = 1.0 - texture(depth_tex, sample_uv).a;
			uv2 = dir2 * scale * pow(light_source_scale, 2.0);
			l *= smoothstep(1.0, 0.999 - light_source_feather, dot(uv2, uv2) * 4.0);
			light_rays += l / float(SAMPLE_COUNT);
		}

		float n = 1.0 - random(UV) * noise_strength * smoothstep(0.999 - 1.25, 1.0, dot(dir2, dir2) * 2.0);
		light_rays *= n;

		vec3 screen_col = texture(screen_texture, SCREEN_UV).rgb;
		float brightness = max(screen_col.r, max(screen_col.g, screen_col.b));
		float moon_mask = smoothstep(mask_threshold, mask_threshold + mask_softness, brightness);

		float dist_to_light = length((UV - light_pos) / ratio);
		float proximity = 1.0 - smoothstep(0.0, mask_radius, dist_to_light);
		moon_mask *= proximity;

		light_rays *= (1.0 - moon_mask);

		COLOR.rgb = vec3(light_rays * ray_intensity) * texture(light_color, UV).rgb * ray_color.rgb;
		COLOR.a = ray_color.a;
	}
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_whbvg"]
resource_local_to_scene = true
shader = SubResource("Shader_cl5sw")
shader_parameter/ray_color = Color(0.92156863, 0.74509805, 0.3372549, 1)
shader_parameter/ray_length = 0.8000000380000001
shader_parameter/ray_intensity = 0.350000016625
shader_parameter/light_source_scale = 1.1999999999970896
shader_parameter/light_source_feather = 1.4499999999970896
shader_parameter/noise_strength = 0.10000000475
shader_parameter/light_source_pos = Vector2(0, 0)
shader_parameter/light_source_dir = Vector3(0.5, -1, 0.25)
shader_parameter/mask_threshold = 0.78400003724
shader_parameter/mask_softness = 0.16900000732898002
shader_parameter/mask_radius = 0.5
shader_parameter/debug_mode = false
shader_parameter/debug_dot_radius = 0.01

[sub_resource type="GDScript" id="GDScript_ikspc"]
script/source = "extends ColorRect

@export var sun_target_path: NodePath
@export var depth_viewport_path: NodePath

@onready var depth_viewport: SubViewport = get_node(depth_viewport_path)
@onready var sun_target: Node3D = get_node(sun_target_path)

func _ready() -> void:
	process_priority = 100
	material.set_shader_parameter(\"depth_tex\", depth_viewport.get_texture())

func _process(_delta: float) -> void:
	var active_cam: Camera3D = get_tree().root.get_camera_3d()
	if not active_cam or not sun_target:
		return

	var cam_forward: Vector3 = -active_cam.global_basis.z
	var target_pos: Vector3 = sun_target.global_position

	if active_cam.is_position_behind(target_pos):
		material.set_shader_parameter(\"light_source_pos\", Vector2(-99999, -99999))
		material.set_shader_parameter(\"camera_dir\", cam_forward)
		return

	var sun_dir: Vector3 = (target_pos - active_cam.global_position).normalized()
	material.set_shader_parameter(\"light_source_dir\", sun_dir)

	var pos: Vector2 = active_cam.unproject_position(target_pos)
	var viewport_size: Vector2 = get_viewport().get_visible_rect().size
	var pos_uv: Vector2 = pos / viewport_size

	material.set_shader_parameter(\"light_source_pos\", pos_uv)
	material.set_shader_parameter(\"camera_dir\", cam_forward)
"

[sub_resource type="Animation" id="Animation_m10gh"]
length = 0.001
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("MainLight:light_energy")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
