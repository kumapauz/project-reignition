time={
"type": "float",
"value": 0.0
}
sun_occlusion={
"type": "float",
"value": 0.0
}
sun_movement={
"type": "float",
"value": 0.0
}
player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
bloom_amount={
"type": "float",
"value": 1.0
}
render_distance={
"type": "float",
"value": 5000.0
}
player_screen_position={
"type": "vec2",
"value": Vector2(0.5, 0.5)
}
environment_fx_intensity={
"type": "float",
"value": 1.0
}
secondary_environment_fx_intensity={
"type": "float",
"value": 0.0
}
