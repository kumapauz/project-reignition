; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[VertexColorSwapper]

"GLTF/Primary Vertex Color Sourcing/else from_this_named_attribute"="_VERTEXCOLOR"

[animation]

warnings/check_invalid_track_paths=false
warnings/check_angle_interpolation_type_conflicting=false
compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sonic and the Secret Rings Remake"
config/description="A fan-remake of the 2007 Nintendo Wii title \"Sonic and the Secret Rings.\""
config/version="v1.0.2"
config/tags=PackedStringArray("active", "c#")
run/main_scene="res://interface/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "C#")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://interface/boot/Icon.png"

[audio]

buses/default_bus_layout="uid://cj6b56mpnrjhw"
general/2d_panning_strength=0.2
general/3d_panning_strength=0.2
default_bus_layout="res://sound/AudioLayout.tres"

[autoload]

Core="*res://core/Core.tscn"
TransitionManager="*res://interface/transition/TransitionManager.tscn"
SoundManager="*res://sound/SoundManager.tscn"
DebugMenu="*uid://cggqb75a8w8r"
PartyManager="*res://party/script/core/party_manager.gd"
NetworkManager="*res://party/NetworkManager.tscn"
PauseManager="*res://party/scene/PauseManager.tscn"
RuleManager="*res://party/scene/rule manager/RuleManager.tscn"
WindowTiler="*uid://cmqjajhjgffm1"
NetworkSimulator="*uid://1y2ey1e6qjwr"
Noray="*uid://gu4bv4tgms3x"
PacketHandshake="*uid://tt3j25a05n7c"
NetworkTime="*uid://cnqdxyjptkfvp"
NetworkTimeSynchronizer="*uid://5rmn2ik3kjo8"
NetworkRollback="*uid://gas743comroj"
NetworkEvents="*uid://bdmobxxptryj0"
NetworkPerformance="*uid://cqgf7aqmjfoa3"
RollbackSimulationServer="*uid://d5vx6blln3jr"
NetworkHistoryServer="*uid://c554fbsy6yos3"
NetworkSynchronizationServer="*uid://yrhqsbd5ubhs"
NetworkIdentityServer="*uid://pc8gwg1lbusp"
NetworkCommandServer="*uid://mkgjb8gdl0fp"
RollbackLivenessServer="*uid://beo1554xbapmy"

[debug]

settings/physics_interpolation/enable_warnings=false
file_logging/enable_file_logging=true
file_logging/max_log_files=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Sonic Remake Project"

[editor_plugins]

enabled=PackedStringArray("res://addons/IVX_VertexColorImportSwapper/plugin.cfg", "res://addons/curve_edit/plugin.cfg", "res://addons/custom_nodes/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/material_importer/plugin.cfg", "res://addons/netfox.extras/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox.noray/plugin.cfg", "res://addons/netfox/plugin.cfg", "res://addons/stage_object_previewer/plugin.cfg")

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false
import/blend/blender_path="C:\\Program Files\\Blender Foundation\\Blender 3.1\\blender.exe"

[global]

local=false

[global_group]

wall="All walls."
floor="Put colliders that act as floors into this group."
ceiling="All ceilings."
pavement="Sfx group for pavement."
"level wall"="Put any wall that should be ignored by lockon triggers into this group."
water="Sfx group for water."
sand="Sfx group for sand."
"sidle wall"="Put any wall that can be collided when sidling into this group."
metal="Sfx group for metal."
grass="Sfx group for grass."
wood="Sfx group for wood."
player="Player's collision group."
"player detection"="The player's environment collider."
crusher="Put any object that can squish the player into this group."
enemy="Put enemies into this group."
rock="Sfx group for rock."
"splash jump"="This object can be bounced off of when performing a splash jump."
"wet wood"="Sfx group for wet wood."
"wet rock"="Sfx group for wet rock."
stone="Sfx group for stone."
snow="Sfx group for snow."
"grind wall"="Stops the player when grinding into an object in this group"
"ignore lockon cast"="Signals that this object shouldn't obstruct Lockon Raycasts."
"force lockon bounce"="Forces the player to perform a bounce when colliding with objects in this group."
"pathtraveller stagger"="Objects in this group stagger the player when on a pathtraveller."
"light dashable"=""
"dustless floor"=""

[gui]

theme/layer_5=""

[importer_defaults]

scene={
"_subresources": {
"nodes": {
"PATH:Floor": {
"generate/physics": true,
"physics/shape_type": 2
},
"PATH:Wall": {
"generate/physics": true,
"physics/shape_type": 2
}
}
},
"animation/fps": 15,
"animation/import": true,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"gltf/embedded_image_handling": 0,
"import_script/path": "",
"meshes/create_shadow_meshes": true,
"meshes/ensure_tangents": true,
"meshes/generate_lods": true,
"meshes/light_baking": 0,
"meshes/lightmap_texel_size": 0.1,
"nodes/apply_root_scale": true,
"nodes/root_name": "Scene Root",
"nodes/root_scale": 1.0,
"nodes/root_type": "Node3D",
"skins/use_named_skins": true
}
animation_library={
"_subresources": {
"nodes": {
"PATH:Floor": {
"generate/physics": true,
"physics/shape_type": 2
},
"PATH:Wall": {
"generate/physics": true,
"physics/shape_type": 2
}
}
},
"animation/fps": 30.0,
"animation/import": true,
"animation/import_rest_as_RESET": false,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"gltf/embedded_image_handling": 0,
"gltf/naming_version": 2,
"import_script/path": "",
"materials/extract": 0,
"materials/extract_format": 0,
"materials/extract_path": "",
"meshes/create_shadow_meshes": true,
"meshes/ensure_tangents": true,
"meshes/force_disable_compression": false,
"meshes/generate_lods": true,
"meshes/light_baking": 0,
"meshes/lightmap_texel_size": 0.1,
"nodes/apply_root_scale": true,
"nodes/import_as_skeleton_bones": false,
"nodes/root_name": "Scene Root",
"nodes/root_scale": 1.0,
"nodes/root_script": null,
"nodes/root_type": "Node3D",
"nodes/use_name_suffixes": true,
"nodes/use_node_type_suffixes": true,
"skins/use_named_skins": true
}

